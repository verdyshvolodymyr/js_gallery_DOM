var gallery = document.querySelector(".gallery");
var galleryList = document.querySelector(".gallery__list");
galleryList.addEventListener("click", function(e) {
    event.preventDefault();
    if (e.target.alt === "thumb") {
        var arr = e.target.closest("a");
        gallery.children[0].children[0].attributes.src.value = arr.href;
